{
  "name": "astrail-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Astrail monorepo",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sklme/astrail.git"
  },
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm build && vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "pnpm templates:check && pnpm lint && pnpm boundaries && pnpm version:check && pnpm typecheck && pnpm test && pnpm build",
    "boundaries": "node scripts/check-boundaries.mjs",
    "changeset": "changeset",
    "release:status": "changeset status",
    "release:version": "changeset version && pnpm version:check",
    "release:publish": "pnpm check && changeset publish",
    "version:check": "node scripts/check-package-versions.mjs",
    "schema:generate": "pnpm --filter astrail-schema generate",
    "templates:check": "pnpm --filter astrail-templates check",
    "resources:check": "node --test scripts/check-public-resources.test.mjs && node scripts/check-public-resources.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@changesets/cli": "3.0.1",
    "@types/node": "22.20.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
