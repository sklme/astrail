{
  "name": "astrail-core",
  "version": "0.11.0",
  "description": "Portable Astrail workspace resolver and lifecycle core",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sklme/astrail.git",
    "directory": "packages/core"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/.tsbuildinfo",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --root ../.. packages/core"
  },
  "dependencies": {
    "astrail-schema": "workspace:*",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "glob": "13.0.6",
    "jsonc-parser": "3.3.1",
    "semver": "7.8.5",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/semver": "7.7.1"
  },
  "homepage": "https://github.com/sklme/astrail#readme",
  "bugs": {
    "url": "https://github.com/sklme/astrail/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
