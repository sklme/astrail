{
  "name": "astrail-schema",
  "version": "0.15.0",
  "description": "Versioned Astrail JSON Schemas and generated TypeScript types",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sklme/astrail.git",
    "directory": "packages/schema"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/.tsbuildinfo",
    "schema",
    "README.md",
    "resources.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./workspace-v1alpha1.json": "./schema/workspace-v1alpha1.schema.json",
    "./local-v1alpha1.json": "./schema/local-v1alpha1.schema.json",
    "./lock-v1alpha1.json": "./schema/lock-v1alpha1.schema.json",
    "./package.json": "./package.json",
    "./resources.json": "./resources.json",
    "./config-v1alpha1.json": "./schema/config-v1alpha1.schema.json"
  },
  "scripts": {
    "generate": "node scripts/generate-config-schema.mjs && biome format --write schema && json2ts -i schema/effective-workspace-v1alpha1.schema.json -o src/generated/workspace.ts && json2ts -i schema/local-v1alpha1.schema.json -o src/generated/local.ts && json2ts -i schema/lock-v1alpha1.schema.json -o src/generated/lock.ts && json2ts -i schema/config-v1alpha1.schema.json -o src/generated/config.ts",
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --root ../.. packages/schema"
  },
  "devDependencies": {
    "json-schema-to-typescript": "15.0.4"
  },
  "homepage": "https://github.com/sklme/astrail#readme",
  "bugs": {
    "url": "https://github.com/sklme/astrail/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
