{
  "name": "astrail",
  "version": "0.15.0",
  "description": "Chart the working trail for every agent",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sklme/astrail.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "astrail": "./dist/index.js"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/.tsbuildinfo",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/program.d.ts",
      "import": "./dist/program.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --root ../.. packages/cli"
  },
  "dependencies": {
    "astrail-core": "workspace:*",
    "astrail-target-codex": "workspace:*",
    "@commander-js/extra-typings": "15.0.0",
    "commander": "15.0.0",
    "semver": "7.8.5",
    "yaml": "2.9.0",
    "astrail-target-codebuddy": "workspace:*",
    "astrail-target-shared": "workspace:*"
  },
  "devDependencies": {
    "@types/semver": "7.7.1"
  },
  "homepage": "https://github.com/sklme/astrail#readme",
  "bugs": {
    "url": "https://github.com/sklme/astrail/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
