{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sklme.github.io/astrail/schema/workspace/v1alpha1.json",
  "title": "Astrail Workspace v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata"],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri-reference"
    },
    "apiVersion": {
      "const": "astrail.dev/v1alpha1"
    },
    "kind": {
      "const": "Workspace"
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "required": ["astrail"],
      "properties": {
        "astrail": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "Semver range of Astrail runtimes compatible with this Workspace."
        }
      }
    },
    "repositories": {
      "$ref": "#/$defs/repositories"
    },
    "environments": {
      "$ref": "#/$defs/environments"
    },
    "contexts": {
      "$ref": "#/$defs/contexts"
    },
    "capabilities": {
      "$ref": "#/$defs/capabilities"
    },
    "operations": {
      "$ref": "#/$defs/operations"
    },
    "policies": {
      "$ref": "#/$defs/policies"
    },
    "targets": {
      "$ref": "#/$defs/targets"
    },
    "editor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workspaceFile": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._ -]*\\.code-workspace$",
          "description": "Root-level .code-workspace filename. When omitted, use metadata.name, then the workspace directory basename if usable, then astrail.code-workspace."
        },
        "default": {
          "enum": ["vscode", "cursor", "codebuddy"],
          "default": "vscode"
        },
        "executables": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "vscode": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\u0000\\r\\n]+$"
            },
            "cursor": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\u0000\\r\\n]+$"
            },
            "codebuddy": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\u0000\\r\\n]+$"
            }
          }
        }
      }
    },
    "extensions": {
      "$ref": "#/$defs/extensions"
    },
    "extends": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/configReference"
      }
    },
    "setup": {
      "$ref": "#/$defs/configSetup"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*$"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "secretReference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "$ref": "#/$defs/identifier"
        },
        "key": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "trust": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "content": {
          "enum": ["trusted", "content-only", "untrusted"]
        },
        "instructions": {
          "enum": ["trusted", "disabled"]
        },
        "executable": {
          "enum": ["trusted", "prompt", "disabled"]
        }
      }
    },
    "repositoryTrust": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "instructions": {
          "enum": ["trusted", "disabled"],
          "default": "disabled"
        }
      }
    },
    "repositoryRevision": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "minLength": 1
        }
      },
      "minProperties": 1,
      "maxProperties": 1
    },
    "gitRepositorySource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "git"
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "$ref": "#/$defs/repositoryRevision"
        }
      }
    },
    "localRepositorySource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "local"
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "subpathRepositorySource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "subpath"
        },
        "repository": {
          "$ref": "#/$defs/identifier"
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "repositorySource": {
      "anyOf": [
        {
          "$ref": "#/$defs/gitRepositorySource"
        },
        {
          "$ref": "#/$defs/localRepositorySource"
        },
        {
          "$ref": "#/$defs/subpathRepositorySource"
        }
      ]
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "disabled": {
          "type": "boolean",
          "default": false
        },
        "description": {
          "type": "string"
        },
        "required": {
          "type": "boolean",
          "default": true
        },
        "access": {
          "enum": ["read-only", "read-write"]
        },
        "role": {
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/repositorySource"
        },
        "trust": {
          "$ref": "#/$defs/repositoryTrust"
        },
        "exports": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "contexts": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "capabilities": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            }
          }
        }
      }
    },
    "repositories": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/identifier"
      },
      "additionalProperties": {
        "$ref": "#/$defs/repository"
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "disabled": {
          "type": "boolean"
        },
        "description": {
          "type": "string"
        },
        "repositories": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "checkout": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "branch": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "branches": {
              "type": "object",
              "minProperties": 1,
              "propertyNames": {
                "$ref": "#/$defs/identifier"
              },
              "additionalProperties": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          }
        },
        "provider": {
          "$ref": "#/$defs/identifier"
        },
        "resources": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "type": ["string", "number", "boolean"]
              },
              {
                "$ref": "#/$defs/secretReference"
              }
            ]
          }
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      }
    },
    "environments": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/identifier"
      },
      "additionalProperties": {
        "$ref": "#/$defs/environment"
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "disabled": {
          "type": "boolean"
        },
        "kind": {
          "enum": ["file", "glob", "builtin", "external", "pack"]
        },
        "description": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "pattern": {
          "type": "string"
        },
        "provider": {
          "enum": ["git-status", "repository-list", "environment-list"]
        },
        "resource": {
          "type": "string"
        },
        "pack": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "priority": {
          "type": "integer",
          "minimum": -1000,
          "maximum": 1000,
          "default": 0
        },
        "trust": {
          "enum": ["trusted", "content-only", "untrusted"],
          "default": "content-only"
        },
        "freshness": {
          "type": "string"
        },
        "sensitivity": {
          "enum": ["public", "workspace", "restricted", "secret"],
          "default": "workspace"
        },
        "budget": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "contexts": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/identifier"
      },
      "additionalProperties": {
        "$ref": "#/$defs/context"
      }
    },
    "capabilityDependency": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "default": "*"
        },
        "mode": {
          "enum": ["required", "peer", "recommended", "optional", "conflicts"]
        }
      }
    },
    "pathCapabilitySource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": ["builtin", "workspace", "repository", "global", "config", "registry", "local"]
        },
        "path": {
          "type": "string"
        },
        "repository": {
          "$ref": "#/$defs/identifier"
        },
        "registry": {
          "type": "string"
        }
      }
    },
    "gitCapabilitySource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "git"
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "$ref": "#/$defs/repositoryRevision"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
        }
      }
    },
    "capabilitySource": {
      "anyOf": [
        {
          "$ref": "#/$defs/pathCapabilitySource"
        },
        {
          "$ref": "#/$defs/gitCapabilitySource"
        }
      ]
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "disabled": {
          "type": "boolean"
        },
        "kind": {
          "enum": ["skill", "tool", "context-pack", "plugin"]
        },
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "default": "*"
        },
        "exposeAs": {
          "$ref": "#/$defs/identifier"
        },
        "description": {
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/capabilitySource"
        },
        "integrity": {
          "type": "string"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/capabilityDependency"
          }
        },
        "suppressed": {
          "type": "boolean"
        },
        "trust": {
          "$ref": "#/$defs/trust"
        }
      }
    },
    "capabilities": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/identifier"
      },
      "additionalProperties": {
        "$ref": "#/$defs/capability"
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "disabled": {
          "type": "boolean"
        },
        "provider": {
          "enum": ["validate", "status", "doctor", "render", "sync", "bootstrap", "lock", "update"]
        },
        "sideEffect": {
          "enum": ["none", "workspace-read", "workspace-write", "network", "external-write"]
        }
      }
    },
    "operations": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/identifier"
      },
      "additionalProperties": {
        "$ref": "#/$defs/operation"
      }
    },
    "policies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "strict": {
          "type": "boolean",
          "default": false
        },
        "allowNetwork": {
          "type": "boolean",
          "default": false
        },
        "recommendations": {
          "enum": ["show", "suppress"],
          "default": "show"
        },
        "projectionStrategy": {
          "enum": ["link", "copy", "manifest"],
          "default": "link"
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "disabled": {
          "type": "boolean"
        },
        "type": {
          "enum": ["codex"]
        },
        "primary": {
          "type": "boolean"
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      }
    },
    "targets": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/identifier"
      },
      "additionalProperties": {
        "$ref": "#/$defs/target"
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z0-9-]+)+$|^[a-z][a-z0-9-]*$"
      },
      "additionalProperties": true
    },
    "configReference": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000\\r\\n]+$"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["local"],
          "properties": {
            "local": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\u0000\\r\\n]+$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["http"],
          "properties": {
            "http": {
              "type": "string",
              "format": "uri",
              "pattern": "^https?://"
            },
            "integrity": {
              "type": "string",
              "pattern": "^sha256-[A-Za-z0-9+/]{43}=$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["git"],
          "properties": {
            "git": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\u0000\\r\\n]+$"
            },
            "ref": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\u0000\\r\\n]+$"
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\u0000\\r\\n]+$"
            },
            "integrity": {
              "type": "string",
              "pattern": "^sha256-[A-Za-z0-9+/]{43}=$"
            }
          }
        }
      ]
    },
    "configSetup": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "skill"],
          "properties": {
            "mode": {
              "const": "skill"
            },
            "skill": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\u0000\\r\\n]+$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": {
              "const": "none"
            }
          }
        }
      ]
    }
  }
}
